{
  "name": "wadzzo",
  "private": true,
  "description": "Wadzzo monorepo: brand portal, fan marketplace, AR collector, mobile app and the shared packages behind them.",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules .turbo .next",
    "db:generate": "pnpm --filter @wadzzo/db generate",
    "db:local": "pnpm --filter @wadzzo/local-db start",
    "db:studio": "pnpm --filter @wadzzo/db studio",
    "dev": "turbo run dev --parallel",
    "dev:ar": "turbo run dev --filter=@wadzzo/ar",
    "dev:brand": "turbo run dev --filter=@wadzzo/brand",
    "dev:market": "turbo run dev --filter=@wadzzo/market",
    "env:check": "node scripts/check-env.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,css,yml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,css,yml}\" --ignore-path .prettierignore",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@wadzzo/prettier-config": "workspace:*",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "^2.5.0",
    "typescript": "catalog:"
  },
  "prettier": "@wadzzo/prettier-config"
}
