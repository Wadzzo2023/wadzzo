{
  "name": "@wadzzo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The shared database: Prisma schema (single source of truth), generated client and the app-wide `db` instance.",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "studio": "prisma studio",
    "push": "node scripts/guarded-db-push.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@wadzzo/errors": "workspace:*",
    "dotenv": "catalog:",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@wadzzo/eslint-config": "workspace:*",
    "@wadzzo/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
