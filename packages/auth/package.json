    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "next-auth": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@wadzzo/eslint-config": "workspace:*",
    "@wadzzo/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "next": "catalog:",
    "next-auth": "catalog:",
    "typescript": "catalog:"
  }
