{
  "name": "@wadzzo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "tRPC foundation shared by the web apps: one context, one set of base procedures, and the routers every app serves.",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@huggingface/transformers": "catalog:",
    "@photostructure/tz-lookup": "catalog:",
    "@stellar/stellar-sdk": "catalog:",
    "@trpc/server": "catalog:",
    "@wadzzo/ar-core": "workspace:*",
    "@wadzzo/auth": "workspace:*",
    "@wadzzo/db": "workspace:*",
    "@wadzzo/errors": "workspace:*",
    "@wadzzo/platform": "workspace:*",
    "@wadzzo/stellar": "workspace:*",
    "@wadzzo/storage": "workspace:*",
    "@wadzzo/utils": "workspace:*",
    "@wadzzo/wallet": "workspace:*",
    "google-auth-library": "catalog:",
    "jsonwebtoken": "catalog:",
    "nodemailer": "catalog:",
    "server-only": "catalog:",
    "square": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "next-auth": "catalog:"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@wadzzo/eslint-config": "workspace:*",
    "@wadzzo/tsconfig": "workspace:*",
    "@wadzzo/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "next": "catalog:",
    "next-auth": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
