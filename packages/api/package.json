{
  "name": "@wadzzo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "tRPC foundation shared by the web apps: one context, one set of base procedures, and the routers every app serves.",
  "exports": {
    ".": "./src/index.ts",
    "./routers/*": "./src/routers/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@trpc/server": "catalog:",
    "@wadzzo/auth": "workspace:*",
    "@wadzzo/db": "workspace:*",
    "@wadzzo/errors": "workspace:*",
    "@wadzzo/platform": "workspace:*",
    "@wadzzo/stellar": "workspace:*",
    "@wadzzo/storage": "workspace:*",
    "@wadzzo/wallet": "workspace:*",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "next-auth": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@wadzzo/eslint-config": "workspace:*",
    "@wadzzo/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "next": "catalog:",
    "next-auth": "catalog:",
    "typescript": "catalog:"
  }
}
