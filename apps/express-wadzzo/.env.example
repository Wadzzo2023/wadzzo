# ══════════════════════════════════════════════════════════════════════
#  Task server (apps/express-wadzzo) — environment
#  Local: copy to .env.  Production: apps/express-wadzzo/.env on the server
#  (chmod 600, created once by hand; the deploy never touches it).
#  Real values are git-ignored; only this file is committed.
# ══════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT="4000"
# Comma-separated browser origins allowed by CORS. Leave empty: only the brand
# app's server calls this service.
ALLOWED_ORIGINS=""
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="200"
# How long one job may run before it is cancelled, and how many run at once.
JOB_TIMEOUT_MS="300000"
WORKER_CONCURRENCY="5"
LOG_LEVEL="info"

# ── Auth ──────────────────────────────────────────────────────────────
# Must be the SAME value as NEXTAUTH_SECRET in the brand app of this
# environment: the brand app sends a key derived from it. Unset in production
# means every request is rejected.
NEXTAUTH_SECRET="<secret>"

# ── Database ──────────────────────────────────────────────────────────
# The same database as the web apps of this environment.
DATABASE_URL="postgresql://user:password@host:5432/wadzzo"

# ── Map agent ─────────────────────────────────────────────────────────
OPENAI_API_KEY="<secret>"
AGENT_MODEL="gpt-5.4-mini"
GOOGLE_MAP_API_KEY="<secret>"

# ── Storage (images it copies and resizes) ────────────────────────────
AWS_BUCKET_NAME="wadzzo-uploads"
AWS_BUCKET_REGION="us-east-1"
AWS_ACCESS_KEY="<secret>"
AWS_SECRET_ACCESS_KEY="<secret>"
