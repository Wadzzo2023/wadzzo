{
  "name": "@wadzzo/express",
  "version": "1.0.0",
  "private": true,
  "description": "The Wadzzo worker: takes jobs from the database queue (the map agent, bulk pin creation, hotspot drops)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@langchain/core": "catalog:",
    "@langchain/openai": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@wadzzo/agent-contract": "workspace:*",
    "@wadzzo/errors": "workspace:*",
    "@wadzzo/geo": "workspace:*",
    "@wadzzo/jobs": "workspace:*",
    "@wadzzo/storage": "workspace:*",
    "dotenv": "catalog:",
    "express": "^5.3.0",
    "geojson": "^0.5.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "catalog:",
    "sharp": "catalog:",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/morgan": "^1.9.10",
    "@types/node": "catalog:",
    "@wadzzo/eslint-config": "workspace:*",
    "@wadzzo/tsconfig": "workspace:*",
    "@wadzzo/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "tsup": "^8.5.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
