# ══════════════════════════════════════════════════════════════════════
#  Fan marketplace — environment
#  Copy to .env.development (local) or set as the host's variables.
#  Real values never get committed: .env.* is git-ignored except this file.
# ══════════════════════════════════════════════════════════════════════

# ── Platform ──────────────────────────────────────────────────────────
# Which white-label platform this deployment serves, and how it presents itself.
# (required) Platform.id this deployment serves (wadzzo, clintoncounty, ...). Also picks the theme and assets at build time.
PLATFORM_SLUG="wadzzo"
# (required) Product name shown in titles and emails.
NEXT_PUBLIC_SITE="Wadzzo"
# (optional) Browser tab title.
NEXT_PUBLIC_TITLE="Wadzzo"
# (required) Meta description.
NEXT_PUBLIC_DESC="Collect the real world"
# (optional) Public URL of the site icon.
NEXT_PUBLIC_ICON="https://example.com/icon.png"
# (required) Public URL of this app (no trailing slash).
NEXT_PUBLIC_URL="http://localhost:3000"
# (required) dev or prod. Prod charges the real network and platform fees.
NEXT_PUBLIC_STAGE="dev"

# ── Database ──────────────────────────────────────────────────────────
# One Postgres shared by every app.
# (required) Postgres connection string.
DATABASE_URL="postgresql://user:password@host:5432/wadzzo"
# (optional) Connections per instance (use 1 behind a small pooler).
DATABASE_POOL_MAX="10"

# ── Sign-in (NextAuth) ────────────────────────────────────────────────
# Sessions for the web apps and the mobile API.
# (required) Canonical URL of this app.
NEXTAUTH_URL="http://localhost:3000"
# (optional) Signs sessions. Also derives the task-server key, so the brand portal and task server must share it.
NEXTAUTH_SECRET="<secret>"

# ── Firebase ──────────────────────────────────────────────────────────
# Shared login (email, Google, Apple, Facebook).
# (required) Web API key.
NEXT_PUBLIC_AUTH_FIREBASE_API_KEY="<firebase-web-api-key>"
# (required) Auth domain.
NEXT_PUBLIC_AUTH_DOMAIN="project.firebaseapp.com"
# (required) Project id.
NEXT_PUBLIC_AUTH_PROJECT_ID="project-id"
# (required) Storage bucket.
NEXT_PUBLIC_AUTH_STORAGE_BUCKET="project.appspot.com"
# (required) Messaging sender id.
NEXT_PUBLIC_AUTH_MESSAGING_SENDER_ID="000000000000"
# (required) App id.
NEXT_PUBLIC_AUTH_APP_ID="1:000000000000:web:0000000000000000"
# (required) Service account email (server).
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk@project.iam.gserviceaccount.com"
# (required) Service account private key (server). Keep the \n escapes.
FIREBASE_ADMIN_PRIVATE_KEY="<secret>"

# ── Stellar ───────────────────────────────────────────────────────────
# Network, the platform token and the platform wallets.
# (optional) testnet or mainnet. One network per deployment.
NEXT_PUBLIC_STELLAR_NETWORK="testnet"
# (required) The platform token's code.
NEXT_PUBLIC_ASSET_CODE="WADZZO"
# (required) The platform token's issuer (public key).
NEXT_PUBLIC_ASSET_ISSUER="G..."
# (required) Domain serving this platform's stellar.toml.
NEXT_PUBLIC_HOME_DOMAIN="wadzzo.com"
# (required) The platform's own account: pays fees, signs for admins.
MOTHER_SECRET="<secret>"
# (required) The account that holds unminted items.
STORAGE_SECRET="<secret>"
# (required) AES key (64 hex chars or base64) for creators' issuer secrets. Must be identical in every app.
ISSUER_ENCRYPTION_KEY="<secret>"
# (required) Lets the server read custodial accounts' keys from the accounts service.
RUBY_ACCOUNTS_SECRET="<secret>"

# ── Payments (Square) ─────────────────────────────────────────────────
# Card payments in the fan app.
# (required)
SQUARE_ACCESS_TOKEN="<secret>"
# (required) sandbox or production.
SQUARE_ENVIRONMENT="sandbox"
# (required)
NEXT_PUBLIC_SQUARE_APP_ID="sandbox-sq0idb-..."
# (required)
NEXT_PUBLIC_SQUARE_LOCATION="<location-id>"

# ── Storage and uploads ───────────────────────────────────────────────
# S3 for files, Pinata for IPFS.
# (required) Public bucket every app writes to.
AWS_BUCKET_NAME="wadzzo-uploads"
# (required)
AWS_BUCKET_REGION="us-east-1"
# (required)
AWS_ACCESS_KEY="<secret>"
# (required)
AWS_SECRET_ACCESS_KEY="<secret>"
# (optional) IPFS pinning.
PINATA_JWT="<secret>"

# ── Maps ──────────────────────────────────────────────────────────────
# (optional) Mapbox token for the maps.
NEXT_PUBLIC_MAPBOX_API="pk...."

# ── Email ─────────────────────────────────────────────────────────────
# (optional) SMTP user (read by the server only).
NEXT_PUBLIC_NODEMAILER_USER="support@example.com"
# (optional) SMTP password (read by the server only).
NEXT_PUBLIC_NODEMAILER_PASS="<secret>"

# ── AI ────────────────────────────────────────────────────────────────
# (optional)
OPENAI_API_KEY="<secret>"
